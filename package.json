{
  "name": "blind-vault",
  "private": true,
  "version": "0.1.0",
  "description": "Blind Vault — Storage Wars on Solana with MagicBlock PER + VRF (Devnet)",
  "workspaces": [
    "app"
  ],
  "scripts": {
    "dev": "npm run dev -w @blind-vault/app",
    "build": "npm run build -w @blind-vault/app",
    "typecheck": "npm run typecheck -w @blind-vault/app",
    "lint": "npm run lint -w @blind-vault/app",
    "test": "cargo test -p blind_vault",
    "anchor:build": "anchor build",
    "anchor:test": "anchor test",
    "init:house": "tsx scripts/01-init-house.ts",
    "seed:items": "tsx scripts/02-seed-items.ts",
    "init:pool": "tsx scripts/03-init-pool.ts",
    "open-vault": "tsx scripts/open-vault.ts",
    "keeper": "tsx scripts/keeper.ts",
    "snoop": "tsx scripts/snoop.ts",
    "auto-round": "tsx scripts/auto-round.ts",
    "auto-round:keep": "tsx scripts/keep-auto-round.ts"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@magicblock-labs/ephemeral-rollups-sdk": "0.17.3",
    "@solana/web3.js": "^1.98.4",
    "@types/node": "^22.13.10",
    "bs58": "^6.0.0",
    "tsx": "^4.20.5",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
